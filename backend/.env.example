# Gemini API key for BrandLens FastAPI backend
# Leave as MY_GEMINI_API_KEY or empty to run in Demo Mode
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional SQLite database path (defaults to ../brandlens.db)
DATABASE_PATH=../brandlens.db

# CORS origin for local Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
